# ---- Server ----
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,https://tour-aku.vercel.app

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://<database-user>:<encoded-password>@<cluster-host>/tour_agency?retryWrites=true&w=majority

# ---- Admin login ----
ADMIN_PASSWORD=

# ---- Phone verification ----
REQUIRE_OTP=false
SMS_ON_APPROVE=false

# ---- SMS provider: console | nikita | smsc ----
SMS_PROVIDER=console
NIKITA_LOGIN=
NIKITA_PASSWORD=
NIKITA_SENDER=SMSPRO.KG
SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_SENDER=TourCo

# ---- Manager email notifications ----
RESEND_API_KEY=
MANAGER_EMAIL=
MANAGER_EMAIL_FROM=onboarding@resend.dev

# ---- Automatic English translations in the admin panel ----
# Create a server-side API key; never put it in the frontend.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
