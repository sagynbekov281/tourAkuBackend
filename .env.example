# ---- Сервер ----
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,https://tour-aku.vercel.app

# ---- MongoDB (создай отдельную бесплатную базу для этого проекта) ----
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/tour_agency?retryWrites=true&w=majority

# ---- Пароль входа в админку ----
ADMIN_PASSWORD=придумай_свой_пароль

# ---- Проверка телефона по SMS-коду (OTP) ----
# false — бронь принимается сразу; true — сначала нужно ввести код из SMS
REQUIRE_OTP=false
# Отправлять SMS клиенту при нажатии "Одобрить" в админке
SMS_ON_APPROVE=false

# ---- SMS ----
# Варианты: console | nikita | smsc
SMS_PROVIDER=console

# --- Если SMS_PROVIDER=nikita (smspro.nikita.kg) ---
NIKITA_LOGIN=
NIKITA_PASSWORD=
NIKITA_SENDER=SMSPRO.KG

# --- Если SMS_PROVIDER=smsc (smsc.ru) ---
SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_SENDER=TourCo

# ---- Email-уведомление менеджеру (Resend.com, бесплатно) ----
RESEND_API_KEY=
MANAGER_EMAIL=
MANAGER_EMAIL_FROM=onboarding@resend.dev
